# Copy to .env.local for local development and set real values.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/zero_clothing?sslmode=require"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-with-a-long-unique-password"
# Generate a random secret of at least 32 characters. Never commit real secrets.
AUTH_SECRET="replace-with-a-random-secret-at-least-32-characters"

# Optional: shared serverless rate limiting (recommended for production).
# Create an Upstash Redis database and copy its REST URL and token.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Optional: public canonical URL used by product SEO metadata.
NEXT_PUBLIC_SITE_URL="https://your-store-domain.example"

# WhatsApp Cloud API (Meta)
# Create approved templates with four BODY placeholders each.
# Confirmation: customer name, order code, total, tracking URL.
# Status update: customer name, order code, new status, tracking URL.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_NUMBER=
WHATSAPP_GRAPH_API_VERSION=v23.0
WHATSAPP_DEFAULT_COUNTRY_CODE=20
WHATSAPP_TEMPLATE_LANGUAGE=ar
WHATSAPP_TEMPLATE_ORDER_CONFIRMATION=zero_order_confirmation
WHATSAPP_TEMPLATE_ORDER_STATUS=zero_order_status_update
