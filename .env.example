# Copy to .env.local for local development and set real values.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/zero_clothing?sslmode=require"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-with-a-long-unique-password"
# Generate a random secret of at least 32 characters. Never commit real secrets.
AUTH_SECRET="replace-with-a-random-secret-at-least-32-characters"

# Optional: shared serverless rate limiting (recommended for production).
# Create an Upstash Redis database and copy its REST URL and token.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Optional: public canonical URL used by product SEO metadata.
NEXT_PUBLIC_SITE_URL="https://your-store-domain.example"
